# ─── NeighbourLink Monorepo Environment Variables ──────────────────────────────

# Ports & Hosts
BACKEND_PORT=4000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=neighborlink_db
DB_USER=neighbor_user
DB_PASSWORD=neighbor_secure_pass
DB_ROOT_PASSWORD=mysql_secure_root_password

# Redis
REDIS_URL=redis://redis:6379

# Meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=meili_secure_master_key_12345

# JWT Auth
JWT_SECRET=neighbourlink_jwt_secret_must_be_32_chars_long_in_prod!

# CORS (Frontend origins)
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio_admin_user
MINIO_SECRET_KEY=minio_admin_password_secure
MINIO_BUCKET=neighborlink-uploads
MINIO_USE_SSL=false
