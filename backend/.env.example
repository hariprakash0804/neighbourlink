# ─── Backend Server Environment Variables ───────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:3000

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=neighborlink
DB_USER=root
DB_PASSWORD=password
DB_SSL=false

# Redis (Caching & Queue)
REDIS_URL=redis://127.0.0.1:6379

# Meilisearch (Full-Text Search)
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=meili_secure_master_key_12345

# JWT Secret (Must be >= 32 characters in production)
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_chars_long

# MinIO / S3 Object Storage (File uploads)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=neighborlink-uploads
MINIO_USE_SSL=false

# SMS OTP Provider (optional for mock/development)
FORCE_DEV_OTP=true
SMS_PROVIDER_API_KEY=
